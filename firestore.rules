rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requester is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user has admin role in Firestore
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to ensure users cannot elevate their own role to admin
    function isNormalUserCreation() {
      return request.resource.data.role == 'user';
    }

    // Users Collection
    match /users/{userId} {
      // Anyone can read their own profile, admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Normal signup: can create user profile only with role = 'user'
      allow create: if isAuthenticated() && request.auth.uid == userId && isNormalUserCreation();
      
      // Users can update their basic info but NEVER change their role to 'admin'
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      
      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }

    // Schools Collection
    match /schools/{schoolId} {
      // Public read access so any student, faculty or visitor can view participating schools
      allow read: if true;
      // Only authorized admins can add, update or deactivate schools
      allow write: if isAdmin();
    }

    // Score Entries Collection
    match /scoreEntries/{scoreId} {
      // Public / normal users can read only approved scores
      allow read: if isAdmin() || resource.data.verificationStatus == 'approved';
      
      // Strict rule: Only authorized admins can create, edit, or delete score entries
      // Normal users CANNOT modify scores under any circumstance
      allow write: if isAdmin();
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      // Public read access for published announcements
      allow read: if true;
      // Only admins can publish, edit or delete announcements
      allow write: if isAdmin();
    }

    // Events Collection
    match /events/{eventId} {
      // Public read access
      allow read: if true;
      // Only admins can manage events
      allow write: if isAdmin();
    }
  }
}
